# 复制为 .env 后填写: cp .env.example .env
# 注意: systemd 的 EnvironmentFile 不支持行尾注释, 注释只能单独成行

# ---- 必填 ----
# BotFather 给的 token
BOT_TOKEN=
# OpenAI 或兼容中转站的 key
OPENAI_API_KEY=

# ---- 翻译后端 ----
# OpenAI 兼容接口地址, 填到 /v1 为止. 官方就保持默认, 中转站/自建改成对应地址
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# ---- 主人限制 ----
# 机器人主人的 Telegram 用户 ID (和机器人私聊发 /help 可以看到).
# 设置后只有主人在场的群才工作, 其他群自动退出; 留空或 0 = 不限制
OWNER_ID=0

# ---- 可选 (以下为默认值, 需要改就去掉前面的 #) ----
# 全局默认语言对, 群里可用 /lang 单独覆盖
#LANG_A=zh
#LANG_B=en
# 逗号分隔的群 chat_id 白名单, 留空=所有群
#ALLOWED_CHATS=
# SQLite 路径 (存术语表、群语言对、opt-out)
#DB_PATH=bot.db
# 翻译时最多回看几条上下文 / 超过多少秒不算上下文 / 上下文总字符上限
#CTX_MAX_MSGS=10
#CTX_MAX_AGE=900
#CTX_MAX_CHARS=1200
# 语言检测置信度阈值
#MIN_CONFIDENCE=0.80
# 少于这么多有效字符的消息不翻译 / 超过这么多字符的消息不翻译
#MIN_CHARS=2
#MAX_CHARS=2000
