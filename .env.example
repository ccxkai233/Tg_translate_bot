# 复制为 .env 后填写: cp .env.example .env
# 注意: systemd 的 EnvironmentFile 不支持行尾注释, 注释只能单独成行

# ---- 必填 ----
# BotFather 给的 token
BOT_TOKEN=
# OpenAI 或兼容中转站的 key
OPENAI_API_KEY=

# ---- 翻译后端 ----
# OpenAI 兼容接口地址, 填到 /v1 为止. 官方就保持默认, 中转站/自建改成对应地址
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# ---- 主人限制 ----
# 机器人主人的 Telegram 用户 ID (和机器人私聊发 /help 可以看到).
# 设置后只有主人在场的群才工作, 其他群自动退出; 留空或 0 = 不限制
OWNER_ID=0

# ---- 双向私聊转发 (需要 OWNER_ID, 默认开启) ----
# 别人私聊机器人 -> 转发给主人并附译文; 主人回复 -> 翻译成对方语言发回. 设为 0 关闭
#RELAY=1
# 主人读写用的语言, 默认等于 LANG_A
#OWNER_LANG=zh
# 访客用英语开口 (或短到识别不出) 时弹一次语言选择菜单让对方自己选; 0 = 不弹, 直接按英语
#RELAY_ASK_LANG=1
# 访客发 /start 时看到的欢迎语, 换行写 \n
#RELAY_WELCOME=
# 对方消息至少这么多有效字符才用来更新"对方说什么语言" (防止 ok/hi 被误判)
#RELAY_DETECT_MIN_CHARS=12

# ---- Web 面板 (需要双向私聊转发; PANEL_URL 留空 = 不启用) ----
# 对外访问地址, 即反代 (Caddy/Nginx) 后的 https 地址, 不带结尾斜杠
#PANEL_URL=https://tg.example.com
# 给登录链接和 Cookie 签名的随机串, 至少 32 位. 生成: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# 换掉它 = 所有已发出的链接和已登录的浏览器立刻失效
#PANEL_SECRET=
# 面板只监听本机, 由反代转发过来
#PANEL_BIND=127.0.0.1
#PANEL_PORT=8787
# 面板里查看过的图片/文件缓存目录
#MEDIA_DIR=media_cache

# ---- 可选 (以下为默认值, 需要改就去掉前面的 #) ----
# 全局默认语言对, 群里可用 /lang 单独覆盖
#LANG_A=zh
#LANG_B=en
# 逗号分隔的群 chat_id 白名单, 留空=所有群
#ALLOWED_CHATS=
# SQLite 路径 (存术语表、群语言对、opt-out)
#DB_PATH=bot.db
# 翻译时最多回看几条上下文 / 超过多少秒不算上下文 / 上下文总字符上限
#CTX_MAX_MSGS=10
#CTX_MAX_AGE=900
#CTX_MAX_CHARS=1200
# 语言检测置信度阈值
#MIN_CONFIDENCE=0.80
# 少于这么多有效字符的消息不翻译 / 超过这么多字符的消息不翻译
#MIN_CHARS=2
#MAX_CHARS=2000
